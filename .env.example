# ─────────────────────────────────────────────────────────────
# Base de données (PostgreSQL obligatoire — requis pour Vercel)
# ─────────────────────────────────────────────────────────────
# Local (Docker) :
#   docker run -d --name logistics-pg \
#     -e POSTGRES_USER=logistics -e POSTGRES_PASSWORD=logistics \
#     -e POSTGRES_DB=logistics -p 5433:5432 postgres:16-alpine
DATABASE_URL="postgresql://logistics:logistics@localhost:5433/logistics"

# Vercel / production : URL PostgreSQL managée (Neon, Supabase, Vercel Postgres…)
# DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ─────────────────────────────────────────────────────────────
# NextAuth
# ─────────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET="change-me-openssl-rand-base64-32"
# En production : URL publique du site (ex. https://mon-site.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# Admin (seed initial)
# ─────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@example.com"
# Mot de passe utilisé par le seed si ADMIN_PASSWORD_HASH est vide.
ADMIN_PASSWORD="admin123"
# Pour imposer un hash : node -e "console.log(require('bcryptjs').hashSync('MOT_DE_PASSE',10))"
ADMIN_PASSWORD_HASH=""

# ─────────────────────────────────────────────────────────────
# Suivi externe — optionnel (active le fallback API externe)
# ─────────────────────────────────────────────────────────────
# AFTERSHIP_API_KEY=""
# SHIP24_API_KEY=""

# ─────────────────────────────────────────────────────────────
# E-mails de notification (Resend) — optionnel
# Sans ces variables, l'app fonctionne normalement mais n'envoie pas d'e-mails.
# 1. Créez un compte sur https://resend.com (3 000 e-mails/mois gratuits)
# 2. Vérifiez votre domaine (Domains → Add Domain)
#    — pour tester sans domaine : RESEND_FROM="Test <onboarding@resend.dev>"
# 3. Créez une clé API (API Keys → Create)
# RESEND_API_KEY="re_..."
# Format : "Nom affiché <adresse@domaine-verifie.com>"
# RESEND_FROM="Landmark Global <no-reply@votredomaine.com>"
